# Vite reads .env files from this directory. The canonical env template
# (covering frontend + backend + provider keys) lives at ../.env.example.
# Copy that file to ../.env, or copy only the VITE_* lines below to ./.env.

# Base URL for the FastAPI backend. Default: http://localhost:8000
# VITE_API_BASE=http://localhost:8000

# Serve endpoints the backend doesn't have yet from in-memory fictional
# fixtures (see docs/ui-backend-gaps.md). Existing endpoints are unaffected.
# VITE_LOOM_MOCKS=1
